# Lucai CLI Environment Configuration

# API Keys (required for AI functionality)
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Code Path (directory to review)
CODE_PATH=./test-code

# Database Configuration
SQLITE_DATABASE=/app/data/lucai.db

# Cache Configuration
REDIS_URL=redis://lucai-cache:6379

# Web Interface (optional)
PORT=3000
NODE_ENV=production

# Logging
LOG_LEVEL=info

# Review Configuration
DEFAULT_MODEL=gpt-4o
DEFAULT_OUTPUT_FORMAT=markdown
DEFAULT_PROFILE=security

# Git Configuration
GIT_AUTHOR_NAME=Lucai Bot
GIT_AUTHOR_EMAIL=bot@lucai.dev
